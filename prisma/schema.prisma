generator client {
  provider = "prisma-client-js"
}

enum Tipo {
  ENTRADA
  SAIDA
}

enum RemessaStatus {
  ABERTO
  FECHADO
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int                 @id @default(autoincrement())
  name      String
  email     String              @unique(map: "User_email_key")
  senha     String
  role      String              @default("admin")
  createdAt DateTime            @default(now())

  remessas       Remessa[]
  reservas       Reserva[]
   
  @@map("user")
}

model Remessa{
  id                Int                   @id @default(autoincrement())
  mes               Int
  ano               Int
  status            RemessaStatus         @default(ABERTO)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  userId            Int
  user              User                  @relation(fields: [userId], references: [id])

  unicoAberto   Boolean?

  movimentacoes  Movimentacao[]
  @@map("remessa")
  @@unique([userId, mes, ano]) // evita duas remessas do mesmo mês/ano por conta
  @@unique([userId, unicoAberto]) // garante apenas uma remessa aberta por conta
}


model Movimentacao {
  id               Int           @id @default(autoincrement())
  descricao        String
  tipo             Tipo
  valor            Decimal       @db.Decimal(10, 2)
  createdAt        DateTime      @default(now())  
  remessaId        Int
  remessa          Remessa       @relation(fields: [remessaId], references: [id])

  @@map("movimentacao")
  
}

model Reserva {
  id               Int        @id @default(autoincrement())
  tipo             Tipo
  valor            Decimal    @db.Decimal(10, 2)
  createdAt        DateTime   @default(now())  
  userId           Int
  user             User       @relation(fields: [userId], references: [id])

  @@map("reserva")
}
